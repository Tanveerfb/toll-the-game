# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
# scratch build dir used with NEXT_DIST_DIR to verify a build while a dev
# server is holding /.next (see next.config.ts)
/.next-verify/
/out/

# production
/build

# misc
.DS_Store
*.pem

# saved battle logs (debug dumps, local only)
/battle-log/
/battle-logs/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# brainstorm mockups
.superpowers/
# reference screenshots (kept locally, INDEX.md stays tracked)
docs/design/references/**/*.jpg

# Vitest browser-mode artefacts — failure screenshots and attachments.
.vitest-attachments/
tests/__screenshots__/

# python bytecode from the art scripts (scripts/skill_art imports its siblings)
__pycache__/

# mockup drafts (project-rules §OWNER, ruling #188); the locked design moves to docs/design/<name>.html
public/_mockups/
